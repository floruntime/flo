[Unit]
Description=Flo Server
Documentation=https://github.com/floruntime/flo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flo
Group=flo
ExecStart=/usr/bin/flo server start --config /etc/flo/flo.toml
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576
# Flo needs to write only its data dir.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/flo

[Install]
WantedBy=multi-user.target
