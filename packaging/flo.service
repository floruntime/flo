[Unit]
Description=Flo Server
Documentation=https://github.com/floruntime/flo
After=network-online.target
Wants=network-online.target
# A crash loop ends as a visible failed unit, not restarts forever: 10 failed
# starts within an hour. An hour, not minutes, because a server that panics
# during log replay spends the replay on every attempt; a short window would
# never see 10 of them.
StartLimitIntervalSec=1h
StartLimitBurst=10

[Service]
Type=simple
User=flo
Group=flo
ExecStart=/usr/bin/flo server start --config /etc/flo/flo.toml
Restart=on-failure
# Exit 78 means the data directory can't be used (another format, or not
# Flo's): restarting never helps, so systemd stops and shows why.
RestartPreventExitStatus=78
# Back off from 5 s to 2 min between attempts. systemd before 254 (Rocky 9
# has 252) warns that it doesn't know these two keys, ignores them and
# keeps the flat 5 s.
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=2min
LimitNOFILE=1048576
# Flo needs to write only its data dir.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/flo

[Install]
WantedBy=multi-user.target
